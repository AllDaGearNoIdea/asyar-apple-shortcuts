{
  "id": "com.asyar.shortcuts",
  "name": "Apple Shortcuts",
  "version": "1.0.0",
  "description": "Search and run Apple Shortcuts with optional input.",
  "author": "Developer",
  "icon": "data:image/svg+xml;base64,",
  "type": "extension",
  "searchable": true,
  "asyarSdk": "^4.7.0",
  "platforms": ["macos"],
  "background": { "main": "dist/worker.js" },
  "permissions": [
    "shell:spawn",
    "fs:watch",
    "storage:read",
    "storage:write",
    "notifications:send",
    "application:read"
  ],
  "permissionArgs": {
    "fs:watch": ["~/Library/Shortcuts/**"],
    "shell:spawn": ["shortcuts", "sqlite3", "/bin/sh"]
  },
  "commands": [
    {
      "id": "open",
      "name": "Apple Shortcuts",
      "description": "Search and run Apple Shortcuts",
      "mode": "view",
      "layout": "list",
      "component": "SearchView"
    }
  ]
}
